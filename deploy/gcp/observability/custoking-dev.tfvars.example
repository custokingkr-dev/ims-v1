# Observability inputs for the migrated dev environment (custoking-dev).
# Real *.tfvars are gitignored because they carry operator email addresses; copy this to
# custoking-dev.tfvars and fill in the channels.
#
#   terraform init -reconfigure \
#     -backend-config="bucket=custoking-dev-terraform-state" \
#     -backend-config="prefix=observability/dev" \
#     -backend-config="access_token=$(gcloud auth print-access-token)"
#   terraform apply -var-file=custoking-dev.tfvars
#
# There is no ADC on the operator workstation, so export GOOGLE_OAUTH_ACCESS_TOKEN for the provider as
# well. The token lasts about an hour; a stale one reads as a 401 on state, which looks like state loss
# but is not.

project = "custoking-dev"
region  = "asia-south2"
env     = "dev"

# Post-migration bucket naming is custoking-<env>-student-photos. Set this explicitly so a restored
# state file or older local tfvars cannot recreate an alert against the retired pre-split bucket name.
storage_bucket_ids = ["custoking-dev-student-photos"]

# OFF in dev, and the reason is money, not noise. Measured 2026-09-03..2026-09-10 in custoking-dev:
# every service receives exactly 4,040 requests a week -- six checker regions x 96 probes a day -- and
# nothing else. Dev's Cloud SQL is stopped outside weekday hours, Spring Boot cannot start without it
# ("Application run failed"), so each probe buys a fresh ~23-second failed JVM boot: 1,100-1,700
# container startups a week PER SERVICE, 68% of probes answered 5xx, and INR ~83/day of Cloud Run CPU
# (INR ~2,500/month, roughly two-thirds of dev's whole bill) spent proving that a database that is
# meant to be off is off. Dev notifications are disabled anyway, so the probes were paging nobody.
#
# Turn on deliberately for a soak, then turn off again. If dev ever needs permanent probes, probe the
# gateway and frontend only -- they start in ~5 s and do not need the database.
enable_uptime_checks = false

# The source project had a single channel, which fails the runbook's own primary-and-backup requirement.
notification_email_addresses = {
  primary = "REPLACE-primary@example.com"
  backup  = "REPLACE-backup@example.com"
}

# Before the split this was prod-only because both environments shared a project. Now that dev has its
# own project, dev logs would otherwise fall to the 30-day _Default bucket with no India-resident routing.
manage_compliance_logging     = true
compliance_log_retention_days = 180

max_instances_by_service = {
  "identity-service"    = 4
  "school-core-service" = 4
  "operations-service"  = 4
  "platform-service"    = 4
  "billing-service"     = 4
  "api-gateway"         = 4
}

# Publish billing-export spend into Cloud Monitoring as custom metrics, feeding the Live Operations
# dashboard's spend panels. Requires a BigQuery billing export writing into this project; leave false
# until that export exists, or the job runs every three hours and finds nothing.
#
# Enabled in custoking-prod. Real tfvars are gitignored, so this example is the only committed record
# that the variable exists -- without it the setting is invisible to anyone rebuilding the environment.
enable_cost_metric_export = true

# A billing account exports to exactly ONE dataset, so environments sharing an account cannot each own
# their export. custoking-dev and custoking-prod share account 014C0A and the export lands in
# custoking-prod, so dev reads that dataset, filters to its own project, and publishes the metric into
# itself. Leave both empty when a project owns its own export.
cost_metric_bq_project    = "custoking-prod"
cost_metric_scope_project = "custoking-dev"

# Set the scope to "*" instead for a cumulative view: one labelled series per project in the export.

# Spend tripwire, GROSS of credits. Dev's honest floor with probes off is roughly INR 35/day (Cloud SQL
# micro on weekdays + storage, Artifact Registry, Secret Manager, the hourly cost job) -- about INR
# 1,100/month -- so INR 2,000 leaves headroom for releases and still reports the cold-start loop above
# at 188% the moment it comes back. This budget notifies even though enable_alert_notifications is
# false: see budget.tf for why money is the exception.
manage_billing_budget = true
billing_account_id    = "014C0A-C6B9AF-5FABC0"
monthly_budget_inr    = 2000

# Cloud Scheduler is not offered in asia-south2, so the trigger runs from the nearest region that has it
# and calls into the job's own region.
# cost_metric_scheduler_region = "asia-south1"
# cost_metric_schedule         = "0 */3 * * *"
