[
  {
    "name": "delete-old-release-images",
    "action": {
      "type": "Delete"
    },
    "condition": {
      "tagState": "any",
      "olderThan": "7d"
    }
  },
  {
    "name": "keep-recent-release-images",
    "action": {
      "type": "Keep"
    },
    "mostRecentVersions": {
      "keepCount": 3
    }
  },
  {
    "name": "keep-reviewed-security-rollback",
    "action": {
      "type": "Keep"
    },
    "condition": {
      "tagState": "tagged",
      "tagPrefixes": ["security-rollback-reviewed-"]
    }
  }
]
