{
  "name": "custoking-api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "contracts:generate": "node ../../scripts/generate-api-route-inventory.js",
    "contracts:check": "node ../../scripts/generate-api-route-inventory.js --check",
    "test": "npm run contracts:check && node --test server.test.js api-contract.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "google-auth-library": "^10.9.1"
  },
  "overrides": {
    "google-auth-library": "$google-auth-library",
    "gaxios": "^7.1.4"
  }
}
