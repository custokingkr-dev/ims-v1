<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="custoking-service"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <threadName/>
                <mdc/>
                <message/>
                <!-- Emits SLF4J structured arguments (StructuredArguments.kv) as real JSON fields rather
                     than rendering them into the message text. Without this, `kv("health", map)` appears
                     only inside the message string, so log-based metrics extracting
                     jsonPayload.health.* match nothing and sit permanently empty with no error. The
                     outbox and notification-inbox metrics were defined against those fields and had
                     never collected a single point until this was added. -->
                <arguments/>
                <stackTrace/>
                <pattern>
                    <pattern>{"service":"${serviceName}"}</pattern>
                </pattern>
                <pattern>
                    <pattern>
                        {
                          "severity": "%level",
                          "logging.googleapis.com/trace": "projects/${GCP_PROJECT:-custoking}/traces/%mdc{traceId:-}",
                          "logging.googleapis.com/spanId": "%mdc{spanId:-}"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
