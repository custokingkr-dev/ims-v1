      "description": "Convert the approved design into production-ready CDR artwork.",
      "phase": "INTAKE",
      "sla": {
        "value": 2,
        "unit": "HOURS"
      },
      "customisedOnly": true,
      "superadminCompletes": false,
      "icon": "Layers",
      "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
      "blocks": [
        {
          "type": "FIELDS",
          "fields": ["cdrLink", "cdrNotes"],
          "save": "Save CDR details"
        },
        {
          "type": "CHECKLIST",
          "title": "Conversion checks",
          "checklist": "cdrChecks"
        },
        {
          "type": "LEGACY_DETAILS",
          "title": "Earlier details recorded on this stage"
        }
