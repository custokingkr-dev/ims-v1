      },
      "checklists": {
        "introChecks": {
          "items": ["Introduction message sent in the school group"],
          "source": "ours"
        }
      },
      "gates": [
        {
          "type": "FIELDS_PRESENT",
          "fields": ["orderPdfLink"]
        },
        {
          "type": "ALL_CHECKED",
          "checklist": "introChecks"
        }
      ]
    },
    {
      "order": 2,
      "code": "DESIGNING_ACTIVITY",
      "title": "Designing Activity",
      "description": "Coordinate school feedback, designer work, drafts and revisions.",
      "phase": "INTAKE",
      "sla": {
        "value": 72,
        "unit": "HOURS"
      },
      "customisedOnly": true,
      "superadminCompletes": false,
      "icon": "PenTool",
      "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
      "blocks": [
        {
          "type": "SCHOOL_GROUP",
          "title": "School Group Chat"
        },
        {
          "type": "DESIGN_FILES",
          "title": "Upload Design Files"
        }
      ],
      "fields": {},
      "checklists": {},
      "gates": [
        {
          "type": "DESIGN_FILES_PRESENT"
        }
      ]
    },
    {
      "order": 3,
      "code": "CDR_CONVERSION",
