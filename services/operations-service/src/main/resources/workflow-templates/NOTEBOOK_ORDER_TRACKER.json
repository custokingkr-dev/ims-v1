        "workbookTotalQuantity": {
          "kind": "WHOLE",
          "label": "Workbook total quantity",
          "min": 0,
          "max": 100000000,
          "legacy": true
        },
        "workbookKing": {
          "kind": "WHOLE",
          "label": "Workbook King",
          "min": 0,
          "max": 100000000,
          "legacy": true
        },
        "workbookJumboKing": {
          "kind": "WHOLE",
          "label": "Workbook Jumbo King",
          "min": 0,
          "max": 100000000,
          "legacy": true
        },
        "workbookLong": {
          "kind": "WHOLE",
          "label": "Workbook Long",
          "min": 0,
          "max": 100000000,
          "legacy": true
        },
        "workbookJumboLong": {
          "kind": "WHOLE",
          "label": "Workbook Jumbo Long",
          "min": 0,
          "max": 100000000,
          "legacy": true
        },
        "workbookFa": {
          "kind": "WHOLE",
          "label": "Workbook FA",
          "min": 0,
          "max": 100000000,
          "legacy": true
        },
        "workbookValidRows": {
          "kind": "WHOLE",
          "label": "Workbook valid rows",
          "min": 0,
          "max": 1000,
          "legacy": true
        }
