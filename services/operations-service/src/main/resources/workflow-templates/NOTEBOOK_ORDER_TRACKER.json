        "workbookSheetName": {
          "kind": "TEXT",
          "label": "Workbook sheet",
          "max": 100,
          "legacy": true
        },
        "workbookOrderId": {
          "kind": "TEXT",
          "label": "Workbook order ID",
          "max": 255,
          "legacy": true
        },
        "workbookImportedAt": {
          "kind": "TEXT",
          "label": "Workbook imported at",
          "max": 40,
          "legacy": true
