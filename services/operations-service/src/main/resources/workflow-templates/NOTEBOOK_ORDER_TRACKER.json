      "gates": [
        {
          "type": "FIELDS_PRESENT",
          "fields": ["cdrLink"]
        },
        {
          "type": "ALL_CHECKED",
          "checklist": "cdrChecks"
        }
      ]
    },
    {
      "order": 4,
      "code": "HEAD_APPROVAL",
      "title": "Head Approval",
