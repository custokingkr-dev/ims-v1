        "cdrFilename": {
          "kind": "TEXT",
          "label": "CDR file name",
          "max": 200,
          "legacy": true
        }
      },
      "checklists": {
        "cdrChecks": {
          "items": ["Fonts outlined", "Colours checked", "Artwork matches approved version"],
          "source": "note"
        }
