        "capacityConfirmed": {
          "kind": "TEXT",
          "label": "Capacity confirmed",
          "max": 50,
          "legacy": true
        },
        "productionStart": {
          "kind": "DATE",
          "label": "Production start",
          "legacy": true
        },
        "planningNotes": {
          "kind": "TEXT",
          "label": "Planning notes",
          "max": 1000,
          "legacy": true
        },
        "workbookFileName": {
          "kind": "TEXT",
          "label": "Workbook file",
          "max": 255,
          "legacy": true
