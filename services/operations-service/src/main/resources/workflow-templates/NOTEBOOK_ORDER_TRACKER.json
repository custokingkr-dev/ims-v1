{
  "definitionId": "NOTEBOOK_ORDER_TRACKER",
  "title": "Notebook order workflow",
  "introMessage": "My name is {Name}, and I will be your point of contact for all notebook-related orders. Please feel free to reach out for any queries, updates, or follow-ups.",
  "steps": [
    {
      "order": 1,
      "code": "ORDER_DETAILS",
      "title": "Order Details",
      "description": "Verify order form, quantity, dimensions and notebook specifications.",
      "phase": "INTAKE",
      "sla": {
        "value": 2,
        "unit": "HOURS"
      },
      "customisedOnly": false,
      "superadminCompletes": false,
      "icon": "ClipboardList",
      "tabs": ["WORK", "CHECKLIST", "ACTIVITY"],
      "blocks": [
        {
          "type": "ORDER_PDF_LINK",
          "title": "School order PDF link",
          "fields": ["orderPdfLink"],
          "save": "Save PDF link"
        },
        {
          "type": "INTRO_MESSAGE",
          "title": "School Group Chat & Introduction Message",
          "checklist": "introChecks",
          "fields": ["introText"]
        }
      ],
      "fields": {
        "orderPdfLink": {
          "kind": "URL",
          "label": "School order PDF link",
          "placeholder": "Paste link to the school order PDF"
        },
        "introText": {
          "kind": "TEXT",
          "label": "Introduction message as sent",
          "max": 1000
