        {
          "type": "INTERNAL_APPROVAL_GROUP",
          "title": "Internal Approval Group Link"
        },
        {
          "type": "CHECKLIST",
          "title": "Mandatory pre-print quality gate",
          "checklist": "checks"
        },
        {
          "type": "FIELDS",
          "fields": ["sampleLink", "schoolVerification", "qcComments"],
          "save": "Save QC evidence"
        },
        {
          "type": "SIGN_OFF",
          "title": "Reviewer sign-off"
        },
        {
          "type": "SEND_BACK"
        }
      ],
      "fields": {
        "sampleLink": {
          "kind": "URL",
          "label": "Print sample evidence link",
          "placeholder": "Photo / sample / approved proof link"
        },
        "schoolVerification": {
          "kind": "CHOICE",
          "label": "School verification",
          "choices": [
            ["NOT_REQUIRED", "Not required"],
            ["PENDING", "Pending"],
            ["VERIFIED", "Verified"],
            ["CHANGES_REQUIRED", "Not verified – changes needed"]
          ]
        },
        "qcComments": {
          "kind": "TEXT",
          "label": "QC reviewer comments",
          "placeholder": "Defects, corrections, exceptions...",
          "max": 1000
        }
      },
      "checklists": {
        "checks": {
          "items": [
            "School name, logo and spelling verified",
            "Latest approved artwork version confirmed",
            "Dimensions, bleed and safe margins checked",
            "Board material, GSM and print specifications verified",
            "Physical print sample inspected for defects",
            "School verification recorded where required",
            "Print quantity and title-wise breakup verified",
            "Authorised quality reviewer releases bulk printing"
          ],
          "signOffItem": 7,
          "source": "prototype"
        }
      },
      "gates": [
        {
          "type": "ALL_CHECKED",
          "checklist": "checks",
          "except": [7]
        },
        {
          "type": "FIELDS_PRESENT",
          "fields": ["sampleLink"]
        },
        {
          "type": "CHOICE_IN",
          "field": "schoolVerification",
          "values": ["VERIFIED", "NOT_REQUIRED"]
        },
        {
          "type": "SIGNED_OFF"
        }
      ],
      "signOff": {
        "label": "Record reviewer sign-off",
        "role": "SUPERADMIN",
        "banner": "Bulk printing blocked until all checks and reviewer sign-off are complete."
      }
