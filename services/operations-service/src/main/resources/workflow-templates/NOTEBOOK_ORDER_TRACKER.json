    {
      "order": 7,
      "code": "PRE_PRINT_QUALITY_GATE",
      "title": "Pre-Print Quality Check",
      "description": "Verify physical sample, margins, colours, material and approvals before bulk printing.",
      "phase": "PRODUCTION",
      "sla": {
        "value": 24,
        "unit": "HOURS"
      },
      "customisedOnly": false,
      "superadminCompletes": false,
      "icon": "ShieldCheck",
      "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
      "blocks": [
        {
          "type": "VENDOR_GROUPS",
          "title": "Offset Printer Group Links",
          "categories": ["OFFSET_PRINTERS"]
