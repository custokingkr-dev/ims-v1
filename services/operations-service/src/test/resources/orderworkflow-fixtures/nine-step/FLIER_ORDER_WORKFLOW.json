{
  "_comment": "Engine test fixture shaped like the nine-step templates of design v1 §2.7.",
  "definitionId": "FLIER_ORDER_WORKFLOW",
  "title": "Flier order workflow",
  "introMessage": "My name is {Name}, and I will be handling your flier order.",
  "steps": [
    {"order": 1, "code": "ORDER_DETAILS", "title": "Order Details", "description": "Verify the order form.", "phase": "INTAKE",
     "sla": {"value": 2, "unit": "HOURS"}, "icon": "ClipboardList", "tabs": ["WORK", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "ORDER_PDF_LINK", "fields": ["orderPdfLink"]}, {"type": "INTRO_MESSAGE", "checklist": "introChecks"}],
     "fields": {"orderPdfLink": {"kind": "URL", "label": "School order PDF link"}},
     "checklists": {"introChecks": {"items": ["Introduction message sent in the school group"], "source": "ours"}},
     "gates": [{"type": "FIELDS_PRESENT", "fields": ["orderPdfLink"]}, {"type": "ALL_CHECKED", "checklist": "introChecks"}]},
    {"order": 2, "code": "DESIGNING_ACTIVITY", "title": "Designing Activity", "description": "Coordinate drafts.", "phase": "INTAKE",
     "sla": {"value": 72, "unit": "HOURS"}, "icon": "PenTool", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "SCHOOL_GROUP"}, {"type": "DESIGN_FILES"}, {"type": "FIELDS", "fields": ["designNotes"]}],
     "fields": {"designNotes": {"kind": "TEXT", "label": "Design notes / version details"}},
     "gates": [{"type": "DESIGN_FILES_PRESENT"}]},
    {"order": 3, "code": "CDR_CONVERSION", "title": "CDR Conversion", "description": "Convert to CDR.", "phase": "INTAKE",
     "sla": {"value": 2, "unit": "HOURS"}, "icon": "Layers", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "FIELDS", "fields": ["cdrLink", "cdrNotes"]}, {"type": "CHECKLIST", "checklist": "cdrChecks"}],
     "fields": {"cdrLink": {"kind": "URL", "label": "Controlled storage link"}, "cdrNotes": {"kind": "TEXT", "label": "Conversion comments"}},
     "checklists": {"cdrChecks": {"items": ["Fonts outlined", "Colours checked", "Artwork matches approved version"], "source": "note"}},
     "gates": [{"type": "FIELDS_PRESENT", "fields": ["cdrLink"]}, {"type": "ALL_CHECKED", "checklist": "cdrChecks"}]},
    {"order": 4, "code": "HEAD_APPROVAL", "title": "Head Approval", "description": "Approve the exact design.", "phase": "INTAKE",
     "sla": {"value": 2, "unit": "HOURS"}, "icon": "BadgeCheck", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "CDR_FOR_APPROVAL", "title": "CDR file submitted for approval"}, {"type": "HEAD_APPROVAL"}],
     "gates": [{"type": "HEAD_APPROVED"}]},
    {"order": 5, "code": "PRODUCTION_PLANNING", "title": "Production Planning", "description": "Plan production.", "phase": "PLANNING",
     "sla": {"value": 24, "unit": "HOURS"}, "icon": "ListChecks", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "ORDER_FOLDER"}, {"type": "ITEM_QUANTITIES"}, {"type": "VENDOR_DIRECTORY"},
                {"type": "VENDOR_SELECTION", "suggestedByItem": {"FE": ["DIGITAL_PRINTERS", "OFFSET_PRINTERS", "PHOTO_PAPER_PRINTERS"], "FX": ["FLEX_PRINTERS"], "BLT": []}},
                {"type": "FIELDS", "fields": ["targetCompletion"]}],
     "fields": {"targetCompletion": {"kind": "DATE", "label": "Target completion date"}},
     "gates": [{"type": "VENDORS_SELECTED"}]},
    {"order": 6, "code": "PRE_PRINT_QUALITY_CHECK", "title": "Pre-Print Quality Check", "description": "Check before printing.", "phase": "PRODUCTION",
     "sla": {"value": 24, "unit": "HOURS"}, "icon": "ShieldCheck", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "VENDOR_GROUPS"}, {"type": "INTERNAL_APPROVAL_GROUP"}, {"type": "FIELDS", "fields": ["qcNotes"]}, {"type": "CHECKLIST", "checklist": "qcChecks"}],
     "fields": {"qcNotes": {"kind": "TEXT", "label": "Quality check notes"}},
     "checklists": {"qcChecks": {"items": ["Flier artwork and print specifications checked and approved"], "source": "prototype"}},
     "gates": [{"type": "ALL_CHECKED", "checklist": "qcChecks"}]},
    {"order": 7, "code": "PRODUCTION_FOLLOW_UP", "title": "Production Follow-up", "description": "Follow up production.", "phase": "PRODUCTION",
     "sla": {"value": 72, "unit": "HOURS"}, "icon": "PhoneCall", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "VENDOR_GROUPS"}, {"type": "CHECKLIST", "checklist": "followUpChecks"}, {"type": "FIELDS", "fields": ["revisedCompletion"]}],
     "fields": {"revisedCompletion": {"kind": "DATE", "label": "Revised completion date"}},
     "checklists": {"followUpChecks": {"items": ["Print job confirmed with the vendor and schedule agreed", "Printing completed",
       "Finishing completed (cutting, lamination or binding as applicable)", "Finished items counted, packed and ready for dispatch"], "source": "ours"}},
     "gates": [{"type": "ALL_CHECKED", "checklist": "followUpChecks"}]},
    {"order": 8, "code": "FINAL_APPROVAL", "title": "Final Approval", "description": "Validate the finished items.", "phase": "VERIFICATION",
     "sla": {"value": 4, "unit": "HOURS"}, "icon": "ClipboardCheck", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "VENDOR_GROUPS"}, {"type": "INTERNAL_APPROVAL_GROUP"}, {"type": "CHECKLIST", "checklist": "finalChecks"},
                {"type": "FIELDS", "fields": ["finalValidationNotes"]}, {"type": "SIGN_OFF"}],
     "fields": {"finalValidationNotes": {"kind": "WORDS", "label": "Final validation notes", "max": 100}},
     "checklists": {"finalChecks": {"items": ["Finished items checked against approved specifications"], "source": "note"}},
     "gates": [{"type": "ALL_CHECKED", "checklist": "finalChecks"}, {"type": "FIELDS_PRESENT", "fields": ["finalValidationNotes"]}, {"type": "SIGNED_OFF"}],
     "signOff": {"label": "Record internal approval"}},
    {"order": 9, "code": "DELIVERY_INVOICING", "title": "Delivery & Invoicing", "description": "Dispatch and invoice.", "phase": "DELIVERY",
     "sla": {"value": 4, "unit": "HOURS"}, "icon": "Receipt", "tabs": ["WORK", "SCHOOL_VENDOR", "CHECKLIST", "ACTIVITY"],
     "blocks": [{"type": "FIELDS", "fields": ["transporter", "dispatchDate", "proofLink", "deliveryStatus", "invoiceStatus"]}, {"type": "VENDOR_GROUPS"}, {"type": "SIGN_OFF"}],
     "fields": {
       "transporter": {"kind": "TEXT", "label": "Transporter / vehicle", "max": 200},
       "dispatchDate": {"kind": "DATE", "label": "Dispatch date"},
       "proofLink": {"kind": "URL", "label": "Proof of delivery / invoice link"},
       "deliveryStatus": {"kind": "CHOICE", "label": "Delivery status", "choices": [["PENDING", "Pending"], ["DELIVERED", "Delivered"]]},
       "invoiceStatus": {"kind": "CHOICE", "label": "Invoice status", "choices": [["NOT_INITIATED", "Not initiated"], ["INITIATED", "Initiated"], ["SENT", "Sent"], ["PAID", "Paid"]]}
     },
     "gates": [{"type": "FIELDS_PRESENT", "fields": ["transporter", "dispatchDate", "proofLink"]},
               {"type": "CHOICE_IN", "field": "deliveryStatus", "values": ["DELIVERED"]}, {"type": "SIGNED_OFF"}],
     "signOff": {"label": "Record consignment sign-off"}}
  ]
}
