  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RecordPaymentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "studentId",
          "amount",
          "idempotencyKey"
        ],
        "properties": {
          "studentId": {
            "type": "integer"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "paidAt": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "actorId": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable logical collection key. Reuse exactly after uncertain outcomes; never regenerate for a retry."
          },
          "assignmentId": {
            "type": "string"
          },
          "academicYearId": {
            "type": "string"
          },
          "schoolId": {
            "type": "integer"
          }
        },
        "x-ims-java-record": {
          "source": "services/school-core-service/src/main/java/com/custoking/ims/schoolcoreservice/api/dto/RecordPaymentRequest.java",
          "name": "RecordPaymentRequest"
        }
      },
      "PaymentResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paymentId",
          "receiptNumber",
          "receiptUrl",
          "studentId",
          "schoolId",
          "assignmentId",
          "academicYearId",
          "amount",
          "mode",
          "paidAmount",
          "netPayable",
          "actorId",
          "paidAt"
        ],
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "receiptNumber": {
            "type": "string"
          },
          "receiptUrl": {
            "type": "string"
          },
          "studentId": {
            "type": "integer"
          },
          "schoolId": {
            "type": "integer"
          },
          "assignmentId": {
            "type": "string"
          },
          "academicYearId": {
            "type": "string"
          },
          "amount": {
            "type": "integer"
          },
          "mode": {
            "type": "string"
          },
          "paidAmount": {
            "type": "integer"
          },
          "netPayable": {
            "type": "integer"
          },
          "actorId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FeeReport": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "studentId"
              ],
              "properties": {
                "studentId": {
                  "type": "integer"
                },
                "assignmentId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "academicYearId": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "x-ims-gateway-service": "fee"
}
