{
  "openapi": "3.1.0",
  "info": {
    "title": "Custoking IMS Identity Authentication API",
    "version": "1.0.0",
    "description": "Canonical browser authentication operations exposed through the API gateway. Internal token introspection is deliberately excluded from the browser client contract."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-ims-service": "identity-service",
  "x-ims-controller": "AuthController",
  "x-ims-audience": "browser",
  "x-ims-client-name": "IdentityAuthClient",
  "x-ims-client-base-path": "/api/v1",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Create an authenticated browser session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated principal and short-lived access token",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh-token cookie",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Rotate the refresh cookie and issue a new access token",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Refreshed authenticated principal",
            "headers": {
              "Set-Cookie": {
                "description": "Rotated HttpOnly refresh-token cookie",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke the current refresh session and clear its cookie",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked; the refresh cookie is expired"
          }
        }
      }
    },
    "/api/v1/auth/password-reset/capabilities": {
      "get": {
        "operationId": "passwordResetCapabilities",
        "x-ims-controller": "PasswordResetController",
        "responses": {
          "200": {
            "description": "Successful request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetCapabilities"
                }
              }
            }
          },
          "429": {
            "description": "Shared request allowance exceeded; Retry-After header is provided"
          },
          "503": {
            "description": "Recovery is not configured"
          }
        }
      }
    },
    "/api/v1/auth/password-reset/request": {
      "post": {
        "operationId": "requestPasswordReset",
        "x-ims-controller": "PasswordResetController",
        "responses": {
          "202": {
            "description": "Successful request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetAccepted"
                }
              }
            }
          },
          "429": {
            "description": "Shared request allowance exceeded; Retry-After header is provided"
          },
          "503": {
            "description": "Recovery is not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "operationId": "confirmPasswordReset",
        "x-ims-controller": "PasswordResetController",
        "responses": {
          "204": {
            "description": "Password changed; existing sessions invalidated"
          },
          "429": {
            "description": "Shared request allowance exceeded; Retry-After header is provided"
          },
          "503": {
            "description": "Recovery is not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirm"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkeys": {
      "get": {
        "operationId": "passkeyStatus",
        "x-ims-controller": "PasskeyController",
        "summary": "passkeyStatus",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Passkey ceremony or session security outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyStatus"
                }
              }
            }
          },
          "403": {
            "description": "Passkey verification or independent privileged approval required"
          },
          "429": {
            "description": "Bounded passkey attempt quota exceeded"
          },
          "503": {
            "description": "Exact RP/origin configuration unavailable"
          }
        }
      }
    },
    "/api/v1/auth/passkeys/registration/options": {
      "post": {
        "operationId": "passkeyRegistrationOptions",
        "x-ims-controller": "PasskeyController",
        "summary": "passkeyRegistrationOptions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Passkey ceremony or session security outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyCeremony"
                }
              }
            }
          },
          "403": {
            "description": "Passkey verification or independent privileged approval required"
          },
          "429": {
            "description": "Bounded passkey attempt quota exceeded"
          },
          "503": {
            "description": "Exact RP/origin configuration unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasskeyPasswordConfirmation"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkeys/registration/verify": {
      "post": {
        "operationId": "passkeyRegistrationVerify",
        "x-ims-controller": "PasskeyController",
        "summary": "passkeyRegistrationVerify",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Passkey ceremony or session security outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyRegistered"
                }
              }
            }
          },
          "403": {
            "description": "Passkey verification or independent privileged approval required"
          },
          "429": {
            "description": "Bounded passkey attempt quota exceeded"
          },
          "503": {
            "description": "Exact RP/origin configuration unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasskeyVerification"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkeys/assertion/options": {
      "post": {
        "operationId": "passkeyAssertionOptions",
        "x-ims-controller": "PasskeyController",
        "summary": "passkeyAssertionOptions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Passkey ceremony or session security outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyCeremony"
                }
              }
            }
          },
          "403": {
            "description": "Passkey verification or independent privileged approval required"
          },
          "429": {
            "description": "Bounded passkey attempt quota exceeded"
          },
          "503": {
            "description": "Exact RP/origin configuration unavailable"
          }
        }
      }
    },
    "/api/v1/auth/passkeys/assertion/verify": {
      "post": {
        "operationId": "passkeyAssertionVerify",
        "x-ims-controller": "PasskeyController",
        "summary": "passkeyAssertionVerify",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Passkey ceremony or session security outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyVerified"
                }
              }
            }
          },
          "403": {
            "description": "Passkey verification or independent privileged approval required"
          },
          "429": {
            "description": "Bounded passkey attempt quota exceeded"
          },
          "503": {
            "description": "Exact RP/origin configuration unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasskeyVerification"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkeys/recovery/request": {
      "post": {
        "operationId": "passkeyRecoveryRequest",
        "x-ims-controller": "PasskeyController",
        "summary": "passkeyRecoveryRequest",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Passkey ceremony or session security outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyRecoveryPending"
                }
              }
            }
          },
          "403": {
            "description": "Passkey verification or independent privileged approval required"
          },
          "429": {
            "description": "Bounded passkey attempt quota exceeded"
          },
          "503": {
            "description": "Exact RP/origin configuration unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasskeyRecoveryRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/passkeys/recovery/approve": {
      "post": {
        "operationId": "passkeyRecoveryApprove",
        "x-ims-controller": "PasskeyController",
        "summary": "passkeyRecoveryApprove",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Passkey ceremony or session security outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyRecovered"
                }
              }
            }
          },
          "403": {
            "description": "Passkey verification or independent privileged approval required"
          },
          "429": {
            "description": "Bounded passkey attempt quota exceeded"
          },
          "503": {
            "description": "Exact RP/origin configuration unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasskeyRecoveryApproval"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "x-ims-java-record": {
          "source": "services/identity-service/src/main/java/com/custoking/ims/identityservice/application/IdentityAuthService.java",
          "name": "LoginRequest",
          "requireAll": true
        }
      },
      "AuthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "userId",
          "fullName",
          "email",
          "role",
          "branchId",
          "branchName",
          "zoneId",
          "zoneName",
          "roles",
          "permissions",
          "operatorSchools",
          "sessionId",
          "stepUpExpiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPERADMIN",
              "ZONE_ADMIN",
              "ADMIN",
              "SCHOOL_ADMIN",
              "OPERATIONS",
              "ACCOUNTANT",
              "TEACHER",
              "VIEWER"
            ]
          },
          "branchId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "branchName": {
            "type": [
              "string",
              "null"
            ]
          },
          "zoneId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "zoneName": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operatorSchools": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "stepUpExpiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "x-ims-java-record": {
          "source": "services/identity-service/src/main/java/com/custoking/ims/identityservice/application/IdentityAuthService.java",
          "name": "AuthResponse",
          "requireAll": true
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "PasswordResetCapabilities": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "PasswordResetConfirm": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72,
            "description": "At most72 UTF-8 bytes; no trimming or normalization."
          }
        }
      },
      "PasswordResetAccepted": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "PasskeyStatus": {
        "type": "object",
        "required": [
          "configured",
          "enrolled",
          "recovery"
        ],
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "enrolled": {
            "type": "boolean"
          },
          "recovery": {
            "type": "string"
          },
          "rpId": {
            "type": "string"
          },
          "canonicalOrigin": {
            "type": "string"
          }
        }
      },
      "PasskeyPasswordConfirmation": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          }
        }
      },
      "PasskeyVerification": {
        "type": "object",
        "required": [
          "challengeId",
          "credential"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "credential": {
            "type": "object",
            "additionalProperties": true,
            "description": "JSON WebAuthn PublicKeyCredential with base64url binary properties"
          }
        }
      },
      "PasskeyCeremony": {
        "type": "object",
        "required": [
          "challengeId",
          "publicKey"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "publicKey": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PasskeyRegistered": {
        "type": "object",
        "required": [
          "enrolled"
        ],
        "properties": {
          "enrolled": {
            "type": "boolean"
          }
        }
      },
      "PasskeyVerified": {
        "type": "object",
        "required": [
          "stepUpExpiresAt"
        ],
        "properties": {
          "stepUpExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PasskeyRecoveryRequest": {
        "type": "object",
        "required": [
          "userId",
          "reason"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "PasskeyRecoveryApproval": {
        "type": "object",
        "required": [
          "recoveryId"
        ],
        "properties": {
          "recoveryId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PasskeyRecoveryPending": {
        "type": "object",
        "required": [
          "recoveryId",
          "expiresAt",
          "requiresDifferentApprover"
        ],
        "properties": {
          "recoveryId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "requiresDifferentApprover": {
            "type": "boolean"
          }
        }
      },
      "PasskeyRecovered": {
        "type": "object",
        "required": [
          "recovered",
          "requiresNewEnrollment"
        ],
        "properties": {
          "recovered": {
            "type": "boolean"
          },
          "requiresNewEnrollment": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Credentials or refresh session are invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  },
  "x-ims-client-file": "identityAuthApi.ts",
  "x-ims-gateway-service": "identity"
}
