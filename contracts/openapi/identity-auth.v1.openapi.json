{
  "openapi": "3.1.0",
  "info": {
    "title": "Custoking IMS Identity Authentication API",
    "version": "1.0.0",
    "description": "Canonical browser authentication operations exposed through the API gateway. Internal token introspection is deliberately excluded from the browser client contract."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-ims-service": "identity-service",
  "x-ims-controller": "AuthController",
  "x-ims-audience": "browser",
  "x-ims-client-name": "IdentityAuthClient",
  "x-ims-client-base-path": "/api/v1",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Create an authenticated browser session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated principal and short-lived access token",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh-token cookie",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Rotate the refresh cookie and issue a new access token",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Refreshed authenticated principal",
            "headers": {
              "Set-Cookie": {
                "description": "Rotated HttpOnly refresh-token cookie",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoke the current refresh session and clear its cookie",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked; the refresh cookie is expired"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessToken",
          "userId",
          "fullName",
          "email",
          "role",
          "branchId",
          "branchName",
          "zoneId",
          "zoneName",
          "roles",
          "permissions",
          "operatorSchools"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string"
          },
          "branchId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "branchName": {
            "type": [
              "string",
              "null"
            ]
          },
          "zoneId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "zoneName": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operatorSchools": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Credentials or refresh session are invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
