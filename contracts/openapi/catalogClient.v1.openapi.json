{
  "openapi": "3.1.0",
  "info": {
    "title": "catalogClient canonical browser API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-ims-service": "school-core-service",
  "x-ims-controller": "CatalogReadController",
  "x-ims-audience": "browser",
  "x-ims-client-name": "CatalogClient",
  "x-ims-client-file": "catalogClient.ts",
  "x-ims-client-base-path": "/api/v1",
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/catalog/orders/page": {
      "get": {
        "operationId": "getOrderPage",
        "parameters": [
          {
            "name": "schoolId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogOrderPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or tenant scope"
          },
          "409": {
            "description": "Conflicting state"
          }
        }
      }
    },
    "/api/v1/catalog/orders/summary": {
      "get": {
        "operationId": "getOrderSummary",
        "parameters": [
          {
            "name": "schoolId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogOrderStatistics"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or tenant scope"
          },
          "409": {
            "description": "Conflicting state"
          }
        }
      }
    },
    "/api/v1/catalog/orders/{id}/status": {
      "patch": {
        "operationId": "updateOrderStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogOrder"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or tenant scope"
          },
          "409": {
            "description": "Conflicting state"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/orders/{id}/deliver": {
      "post": {
        "operationId": "markDelivered",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogOrder"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or tenant scope"
          },
          "409": {
            "description": "Conflicting state"
          }
        }
      }
    },
    "/api/v1/catalog/annual-plan/review": {
      "get": {
        "operationId": "reviewAnnualPlan",
        "parameters": [
          {
            "name": "schoolId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnualPlanReview"
                }
              }
            }
          },
          "400": {
            "description": "Choose a school"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or school scope"
          },
          "409": {
            "description": "Missing or changed review fingerprint, or empty current-year plan"
          },
          "503": {
            "description": "Confirmation unavailable"
          }
        }
      }
    },
    "/api/v1/catalog/annual-plan/confirm": {
      "post": {
        "operationId": "confirmAnnualPlan",
        "parameters": [
          {
            "name": "schoolId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnualPlanConfirmation"
                }
              }
            }
          },
          "400": {
            "description": "Choose a school"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or school scope"
          },
          "409": {
            "description": "Missing or changed review fingerprint, or empty current-year plan"
          },
          "503": {
            "description": "Confirmation unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fingerprint": {
                    "type": "string"
                  }
                },
                "required": [
                  "fingerprint"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/orders/{id}/tracker-summary": {
      "get": {
        "operationId": "getNotebookTrackerSummary",
        "summary": "Header data for the notebook order tracker",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-ims-controller": "CatalogOrderFormController",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotebookTrackerSummary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; the message says what to change"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "The caller's role or assignment does not allow this"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "A rule refused it; the message says which"
          }
        }
      }
    },
    "/api/v1/catalog/orders/{id}/tracker/ensure": {
      "post": {
        "operationId": "ensureNotebookTracker",
        "summary": "Start the tracker of a placed notebook order whose tracker is not created yet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-ims-controller": "CatalogOrderFormController",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackerEnsureResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; the message says what to change"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "The caller's role or assignment does not allow this"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "A rule refused it; the message says which"
          }
        }
      }
    },
    "/api/v1/catalog/orders/{id}/assets": {
      "get": {
        "operationId": "listOrderAssets",
        "summary": "Every attachment of the order, superseded ones included",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-ims-controller": "CatalogOrderFormController",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderAsset"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; the message says what to change"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "The caller's role or assignment does not allow this"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "A rule refused it; the message says which"
          }
        }
      },
      "post": {
        "operationId": "uploadOrderAsset",
        "summary": "Upload an attachment (a design draft uses assetKind DESIGN_DRAFT)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-ims-controller": "CatalogOrderFormController",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/OrderAssetUpload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderAsset"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; the message says what to change"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "The caller's role or assignment does not allow this"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "A rule refused it; the message says which"
          }
        }
      }
    },
    "/api/v1/catalog/orders/{id}/assets/{assetId}": {
      "delete": {
        "operationId": "deleteOrderAsset",
        "summary": "Remove an attachment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "x-ims-controller": "CatalogOrderFormController",
        "responses": {
          "204": {
            "description": "Removed"
          },
          "400": {
            "description": "Invalid request; the message says what to change"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "The caller's role or assignment does not allow this"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "A rule refused it; the message says which"
          }
        }
      }
    },
    "/api/v1/catalog/orders/{id}/assets/{assetId}/content": {
      "get": {
        "operationId": "getOrderAssetContent",
        "summary": "The attachment's bytes",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "x-ims-controller": "CatalogOrderFormController",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; the message says what to change"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "The caller's role or assignment does not allow this"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "A rule refused it; the message says which"
          }
        }
      }
    },
    "/api/v1/supply/product-catalog/categories": {
      "get": {
        "operationId": "listProductCategories",
        "summary": "The active catalogue items",
        "parameters": [],
        "x-ims-controller": "CatalogProductFormController",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductCategory"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; the message says what to change"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "The caller's role or assignment does not allow this"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "A rule refused it; the message says which"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CatalogOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "schoolId": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "totalAmount": {
            "type": "number"
          },
          "trackerManaged": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "True for a notebook order placed on the notebook order tracker; one placed before it keeps the approval flow."
          }
        },
        "required": [
          "id",
          "category",
          "schoolId",
          "status"
        ],
        "additionalProperties": true
      },
      "CatalogOrderPage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogOrder"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "content",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "additionalProperties": true
      },
      "CatalogOrderStatistics": {
        "type": "object",
        "properties": {
          "totalOrders": {
            "type": "number"
          },
          "pendingApproval": {
            "type": "number"
          },
          "approved": {
            "type": "number"
          },
          "rejected": {
            "type": "number"
          },
          "gmv": {
            "type": "number"
          },
          "activeOrders": {
            "type": "number"
          },
          "termSpend": {
            "type": "number"
          },
          "activeServices": {
            "type": "number"
          },
          "deliveredCount": {
            "type": "number"
          }
        },
        "required": [
          "totalOrders",
          "pendingApproval",
          "approved",
          "rejected",
          "gmv",
          "activeOrders",
          "termSpend",
          "activeServices",
          "deliveredCount"
        ],
        "additionalProperties": true
      },
      "AnnualPlanConfirmation": {
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "schoolId": {
            "type": "integer"
          },
          "academicYearId": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time"
          },
          "itemCount": {
            "type": "integer"
          },
          "fingerprint": {
            "type": "string"
          },
          "notificationStatus": {
            "type": "string",
            "enum": [
              "NOT_SENT"
            ]
          }
        },
        "required": [
          "confirmed",
          "id",
          "schoolId",
          "academicYearId",
          "revision",
          "confirmedAt",
          "itemCount",
          "fingerprint",
          "notificationStatus"
        ],
        "additionalProperties": true
      },
      "AnnualPlanReviewItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "term": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "linkedOrderId": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimatedAmount": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "term",
          "category",
          "description",
          "quantity",
          "status",
          "linkedOrderId",
          "estimatedAmount"
        ],
        "additionalProperties": true
      },
      "AnnualPlanReview": {
        "type": "object",
        "properties": {
          "schoolId": {
            "type": "integer"
          },
          "academicYearId": {
            "type": "string"
          },
          "yearLabel": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnnualPlanReviewItem"
            }
          },
          "fingerprint": {
            "type": "string"
          },
          "confirmation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnnualPlanConfirmation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schoolId",
          "academicYearId",
          "yearLabel",
          "items",
          "fingerprint",
          "confirmation"
        ],
        "additionalProperties": true
      },
      "NotebookTrackerSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "orderId": {
            "type": "string"
          },
          "schoolId": {
            "type": "integer",
            "format": "int64"
          },
          "schoolName": {
            "type": [
              "string",
              "null"
            ]
          },
          "schoolContactEmail": {
            "type": [
              "string",
              "null"
            ]
          },
          "schoolContactPhone": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "customised": {
            "type": "boolean"
          },
          "requiredByDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "placedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "schoolNotes": {
            "type": [
              "string",
              "null"
            ]
          },
          "orderedCount": {
            "type": "integer"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lineNo": {
                  "type": "integer"
                },
                "selections": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "spec": {
                            "type": "string"
                          },
                          "specText": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "code",
                          "label"
                        ]
                      }
                    ]
                  }
                },
                "bookCount": {
                  "type": "integer"
                },
                "pageCount": {
                  "type": "integer"
                }
              },
              "required": [
                "lineNo",
                "selections",
                "bookCount",
                "pageCount"
              ]
            }
          },
          "trackerPending": {
            "type": "boolean"
          }
        },
        "required": [
          "orderId",
          "schoolId",
          "schoolName",
          "schoolContactEmail",
          "schoolContactPhone",
          "status",
          "customised",
          "requiredByDate",
          "placedAt",
          "schoolNotes",
          "orderedCount",
          "lines",
          "trackerPending"
        ]
      },
      "TrackerEnsureResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "trackerPending": {
            "type": "boolean"
          }
        },
        "required": [
          "trackerPending"
        ]
      },
      "OrderAsset": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "assetKind": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "checksumSha256": {
            "type": "string"
          },
          "originalFilename": {
            "type": [
              "string",
              "null"
            ]
          },
          "uploadedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "uploadedAt": {
            "type": "string"
          },
          "supersededAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "assetKind",
          "contentType",
          "sizeBytes",
          "uploadedAt"
        ]
