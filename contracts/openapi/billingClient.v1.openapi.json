{
  "openapi": "3.1.0",
  "info": {
    "title": "Custoking billing statistics",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "x-ims-service": "billing-service",
  "x-ims-controller": "BillingInvoiceController",
  "x-ims-audience": "browser",
  "x-ims-client-name": "BillingClient",
  "x-ims-client-file": "billingClient.ts",
  "x-ims-client-base-path": "/api/v1",
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/billing/sa/invoices/stats": {
      "get": {
        "operationId": "getInvoiceStatistics",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceStatistics"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or tenant scope"
          },
          "409": {
            "description": "Conflicting state"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "InvoiceStatistics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sentThisMonth",
          "paid",
          "pending",
          "totalInvoiced",
          "periodStart",
          "periodEndExclusive",
          "reportingTimeZone"
        ],
        "properties": {
          "sentThisMonth": {
            "type": "integer"
          },
          "paid": {
            "type": "integer"
          },
          "pending": {
            "type": "integer"
          },
          "totalInvoiced": {
            "type": "integer"
          },
          "periodStart": {
            "type": "string",
            "format": "date"
          },
          "periodEndExclusive": {
            "type": "string",
            "format": "date"
          },
          "reportingTimeZone": {
            "type": "string"
          }
        }
      },
      "CreateBillingPaymentRequest": {
        "type": "object",
        "additionalProperties": false,
        "x-ims-java-record": {
          "source": "services/billing-service/src/main/java/com/custoking/ims/billingservice/api/dto/CreateBillingPaymentRequest.java",
          "name": "CreateBillingPaymentRequest"
        },
        "required": [
          "invoiceId",
          "amount",
          "paymentMode",
          "idempotencyKey"
        ],
        "properties": {
          "invoiceId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Existing INR whole-rupee ledger units"
          },
          "paymentDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Optional past/present date; replay preserves the original key/body"
          },
          "paymentMode": {
            "type": "string",
            "enum": [
              "CASH",
              "UPI",
              "BANK_TRANSFER",
              "CHEQUE",
              "CARD",
              "OTHER"
            ]
          },
          "referenceNo": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{8,128}$",
            "minLength": 8,
            "maxLength": 128
          }
        }
      }
    }
  },
  "x-ims-gateway-service": "billing",
  "x-ims-compatibility-request-bindings": [
    {
      "method": "POST",
      "path": "/api/v1/billing-payments",
      "controller": "BillingPublicCompatibilityController",
      "classification": "compatibility",
      "requestSchema": "#/components/schemas/CreateBillingPaymentRequest",
      "description": "Existing compatibility endpoint, no current browser caller; intentionally excluded from canonical generated operations. Same invoice/key/body replays; changed body conflicts. Actor and branch are server-bound."
    }
  ]
}
